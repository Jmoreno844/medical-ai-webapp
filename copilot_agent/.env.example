COPILOT_AGENT_ENV=local
COPILOT_AGENT_PORT=8090
COPILOT_AGENT_LOG_LEVEL=INFO

# Runtime LLM provider selection.
COPILOT_LLM_PROVIDER_FAMILY=openai
COPILOT_PLANNER_MODEL=gpt-5.4-mini
COPILOT_PATCH_MODEL=gpt-5.4-mini

# Optional component-level overrides if you want planner and drafter on different providers/models.
# COPILOT_PLANNER_PROVIDER_FAMILY=openai
# COPILOT_PATCH_PROVIDER_FAMILY=anthropic
# COPILOT_PATCH_MODEL=claude-haiku-4-5

# Google/Vertex settings are only required when a planner or patch model uses provider_family=google.
GCP_PROJECT_ID=vext-stg
GCP_REGION=us-east1
VERTEX_MODEL=gemini-2.5-flash
# Optional override if a specific Gemini model needs a location different from GCP_REGION.
# COPILOT_GOOGLE_LOCATION=global
COPILOT_PLANNER_MAX_ITERATIONS=6

COPILOT_AGENT_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/medical_web_app
COPILOT_LONG_TERM_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/medical_web_app

BACKEND_INTERNAL_BASE_URL=http://host.docker.internal:8000
BACKEND_INTERNAL_TIMEOUT_SECONDS=15
COPILOT_SERVICE_SHARED_JWT=change-me
COPILOT_ALLOWED_AUDIENCE=app-api-service
COPILOT_BACKEND_AUDIENCE=medical-api

# Provider API keys.
OPENAI_API_KEY=change-me
# ANTHROPIC_API_KEY=change-me

# Optional local LangSmith runtime/eval tracing.
# Runtime traces only record sanitized metadata and use a separate project from cloud_functions.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=change-me
LANGSMITH_PROJECT=copilot-agent-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TEST_SUITE=copilot-agent-local-live
# LANGSMITH_EXPERIMENT=manual-dev
# LANGSMITH_TEST_TRACKING=true

# Optional multi-provider Promptfoo evals reuse the same runtime/provider env above.
