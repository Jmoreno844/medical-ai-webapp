ENVIRONMENT=local
PORT=8093
CLINICAL_EXTRACTION_LOG_LEVEL=INFO

# Local FastAPI backend.
BACKEND_INTERNAL_BASE_URL=http://localhost:8001

# GCP project for Gemini via Vertex AI.
GCP_PROJECT_ID=tu-proyecto
VERTEX_AI_LOCATION=global

# Provider: gemini (default), openai, or anthropic_api
CLINICAL_EXTRACTION_PROVIDER=gemini
CLINICAL_EXTRACTION_MODEL=gemini-2.5-flash
CLINICAL_EXTRACTION_OPENAI_MODEL=gpt-5.4-mini
CLINICAL_EXTRACTION_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only if CLINICAL_EXTRACTION_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only if CLINICAL_EXTRACTION_PROVIDER=anthropic_api
# ANTHROPIC_API_KEY=sk-ant-...

# Optional in local; Cloud Tasks auth is bypassed when ENVIRONMENT=local.
# CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=
