# FastAPI production environment template.
# Do not copy this into the repo with real values. Use Cloud Run env vars and
# Secret Manager for deployed production configuration.
ENVIRONMENT=production
DEBUG=false

FASTAPI_CORS_ALLOWED_ORIGINS=https://app.example.com
FASTAPI_COOKIE_SECURE=true
FASTAPI_COOKIE_SAMESITE=lax

# Prefer DATABASE_URL in deployed environments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

JWT_SECRET_KEY=replace-with-secret-manager-value
COPILOT_SERVICE_SHARED_JWT=replace-with-secret-manager-value
COPILOT_AGENT_AUDIENCE=app-api-service
COPILOT_BACKEND_AUDIENCE=medical-api

GCP_PROJECT_ID=your-production-project-id
GCS_BUCKET_NAME=your-production-audio-bucket
GCP_STT_LOCATION=us
GCP_STT_MODEL=chirp_3
GCP_STORAGE_IMPERSONATED_SERVICE_ACCOUNT=
GCP_STORAGE_SERVICE_ACCOUNT_KEY_PATH=
SERVICE_ACCOUNT_JSON=

TRANSCRIPTION_CLOUD_FUNCTION_URL=https://your-production-transcription-function
GENERATE_DOCUMENT_CLOUD_FUNCTION_URL=https://your-production-generation-function

CLOUD_TASKS_REGION=us-east1
TRANSCRIPTION_QUEUE_NAME=your-production-transcription-queue
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=your-production-invoker@PROJECT_ID.iam.gserviceaccount.com

COPILOT_AGENT_BASE_URL=https://your-production-copilot-agent
COPILOT_AGENT_TIMEOUT_SECONDS=60
