# FastAPI staging environment template.
# Copy to backend_fastapi/.env.stg only for local staging-like smoke tests.
# In deployed staging, prefer Cloud Run env vars and Secret Manager.
ENVIRONMENT=staging
DEBUG=false

FASTAPI_CORS_ALLOWED_ORIGINS=https://staging.example.com
FASTAPI_COOKIE_SECURE=true
FASTAPI_COOKIE_SAMESITE=lax

# Prefer DATABASE_URL in deployed environments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

JWT_SECRET_KEY=replace-with-secret-manager-value
COPILOT_SERVICE_SHARED_JWT=replace-with-secret-manager-value
COPILOT_AGENT_AUDIENCE=app-api-service
COPILOT_BACKEND_AUDIENCE=medical-api

GCP_PROJECT_ID=your-staging-project-id
GCS_BUCKET_NAME=your-staging-audio-bucket
GCP_STT_LOCATION=us
GCP_STT_MODEL=chirp_3
GCP_STORAGE_IMPERSONATED_SERVICE_ACCOUNT=
GCP_STORAGE_SERVICE_ACCOUNT_KEY_PATH=
SERVICE_ACCOUNT_JSON=

TRANSCRIPTION_TASK_TARGET_URL=https://your-staging-backend/api/v1/internal/transcription/tasks
GENERATE_DOCUMENT_CLOUD_FUNCTION_URL=https://your-staging-generation-function

CLOUD_TASKS_REGION=us-east1
TRANSCRIPTION_QUEUE_NAME=your-staging-transcription-queue
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=your-staging-invoker@PROJECT_ID.iam.gserviceaccount.com

COPILOT_AGENT_BASE_URL=https://your-staging-copilot-agent
COPILOT_AGENT_TIMEOUT_SECONDS=60
