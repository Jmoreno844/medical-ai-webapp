# Copy to .env.local for local work.
# Docker Compose mounts ADC to /app/adc.json and sets GOOGLE_APPLICATION_CREDENTIALS.

ENVIRONMENT=local
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-east1

GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.4
TOP_P=0.95
MAX_OUTPUT_TOKENS=8192

DJANGO_API_BASE_URL=http://localhost:8000/
