# Copy to .env.local for local work.
# Docker Compose mounts ADC to /app/adc.json and sets GOOGLE_APPLICATION_CREDENTIALS.

ENVIRONMENT=local
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-east1

GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.4
TOP_P=0.95
MAX_OUTPUT_TOKENS=8192

BACKEND_API_BASE_URL=http://localhost:8000
BACKEND_API_VERSION=v1
# Legacy fallback still accepted while platform envs are migrated:
# DJANGO_API_BASE_URL=http://localhost:8000

# Optional local LangSmith tracing (metadata only, separate project from copilot_agent)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=change-me
LANGSMITH_PROJECT=cloud-functions-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
