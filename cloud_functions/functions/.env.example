# Copy to .env.local (not committed). Docker Compose sets GOOGLE_APPLICATION_CREDENTIALS
# to /app/adc.json via ADC mount — do not set it here unless you override compose.

PROJECT_ID=vext-stg
LOCATION=us-east1
# Use local for Docker Compose / local functions-framework. (env_file can override compose.)
ENVIRONMENT=local

GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.4
TOP_P=0.95
MAX_OUTPUT_TOKENS=8192
CANDIDATE_COUNT=1

DJANGO_API_BASE_URL=http://localhost:8000/
