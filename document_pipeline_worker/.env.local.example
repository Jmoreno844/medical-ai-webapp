ENVIRONMENT=local
PORT=8092
LOG_LEVEL=DEBUG
BACKEND_INTERNAL_BASE_URL=http://localhost:8001

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

PIPELINE_FILTERING_PROVIDER=openai
PIPELINE_CLUSTERING_PROVIDER=openai
PIPELINE_CLASSIFICATION_PROVIDER=openai
PIPELINE_CONTEXT_PROVIDER=openai
PIPELINE_GENERATION_PROVIDER=openai
PIPELINE_CONTEXT_ENABLED=true

PIPELINE_GENERATION_STRATEGY=single_call_per_section
PIPELINE_GENERATION_PROMPT_VERSION=v002
