# Django
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
JWT_SECRET_KEY=replace-with-a-local-jwt-secret
DEBUG=true
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
DB_NAME=medical_web_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# GCP / Storage
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-audio-bucket
GCP_STORAGE_IMPERSONATED_SERVICE_ACCOUNT=backend-local-gcs-signer@your-gcp-project-id.iam.gserviceaccount.com
GCP_STORAGE_SERVICE_ACCOUNT_KEY_PATH=

# Local Cloud Functions
TRANSCRIPTION_CLOUD_FUNCTION_URL=http://localhost:8082
GENERATE_DOCUMENT_CLOUD_FUNCTION_URL=http://localhost:8083

# Local copilot agent
COPILOT_AGENT_BASE_URL=http://localhost:8090
COPILOT_SERVICE_SHARED_JWT=test-shared-jwt
COPILOT_AGENT_AUDIENCE=app-api-service
COPILOT_BACKEND_AUDIENCE=medical-api
COPILOT_AGENT_TIMEOUT_SECONDS=60

# Optional tracing
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_NAME=vexthealth-backend
