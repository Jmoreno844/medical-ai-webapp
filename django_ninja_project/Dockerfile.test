FROM python:3.10-slim

WORKDIR /app

# Install system dependencies including PostgreSQL dev packages and netcat
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql \
    postgresql-contrib \
    python3-dev \
    libpq-dev \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install specific poetry version and configure it
RUN pip install "poetry==1.7.1" \
    && poetry config virtualenvs.create false

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install dependencies with explicit Django installation verification
RUN poetry install --no-interaction --no-ansi \
    && poetry run pip freeze | grep Django

# Copy project files
COPY . .

# Set the entrypoint
COPY scripts/test-entrypoint.sh /test-entrypoint.sh
RUN chmod +x /test-entrypoint.sh

ENTRYPOINT ["/test-entrypoint.sh"]
